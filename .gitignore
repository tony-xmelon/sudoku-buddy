# Full-resolution corpus photographs are large (roughly 20MB each) and do not
# belong in git history. See docs/superpowers/specs for the corpus policy.
# corpus-labels/ IS committed: the labels are hand-made ground truth and tiny,
# while the photographs they describe stay local.
corpus/*.jpg
corpus/*.jpeg
corpus/*.png

# Android / Gradle
.gradle/
build/
local.properties
*.apk
*.aab
captures/
.cxx/

# IDE
.idea/
*.iml

# Python (model training)
__pycache__/
*.pyc
.venv/
venv/

# Firebase App Distribution: the service account key is a credential.
# google-services.json is not secret and may be committed when the app module exists.
firebase-service-account*.json
*-service-account.json
.firebase/

# Training artefacts
tools/recognizer/data/
tools/recognizer/*.pt
tools/recognizer/*.onnx
tools/recognizer/digits.bin
tools/recognizer/digits.json

# Screenshots the user sends as feedback. Same policy as the corpus: they are
# photographs of a real page, so they stay on this machine.
feedback/

# Signing keys. The release key must never enter the repository: anyone holding it can
# publish an update that phones will accept as genuine. It lives on one machine and in
# the repository's secrets. See docs/signing.md.
*.jks
*.keystore
corpus-rectified/*.jpg
